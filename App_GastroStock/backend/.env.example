# Configuración del backend GastroStock
# Copia este archivo como ".env" y ajusta los valores según tu equipo.

PORT=3007
NODE_ENV=development

# Base de datos independiente para GastroStock
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=TU_PASSWORD_DE_MYSQL
DB_NAME=restaurant_inventarios_db

# JWT - DEBE ser el mismo que en Sistema_Principal para SSO
JWT_SECRET=restaurant_jwt_secret_key_2026
JWT_EXPIRES_IN=24h
